+  let width = bufferSize.width
+  let height = bufferSize.height
+  
+  switch orientation {
+  case .right: // 90° CW rotation (landscape-left → portrait)
+    // For 90° CW: new_x = old_y, new_y = width - old_x - old_width
+    return CGRect(
+      x: rectF.minY,
+      y: width - rectF.maxX,
+      width: rectF.height,
+      height: rectF.width
+    )
+  case .left: // 270° CW rotation (landscape-right → portrait)
+    // For 270° CW: new_x = height - old_y - old_height, new_y = old_x
+    return CGRect(
+      x: height - rectF.maxY,
+      y: rectF.minX,
+      width: rectF.height,
+      height: rectF.width
+    )
+  case .down: // 180° rotation (upside-down → portrait)
+    return CGRect(
+      x: width - rectF.maxX,
+      y: height - rectF.maxY,
+      width: rectF.width,
+      height: rectF.height
+    )
+  case .up, .upMirrored, .downMirrored, .leftMirrored, .rightMirrored:
+    // No rotation needed for portrait or mirrored cases
+    return rectF
+  @unknown default:
+    return rectF
+  }
+}
